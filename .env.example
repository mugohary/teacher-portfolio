# ------------------------------------------------------------------
# Arabic & Quran Teacher Portfolio — Environment Configuration
# Copy to `.env` and fill in real values. All client-exposed keys
# MUST be prefixed with VITE_ (they are inlined into the bundle).
# ------------------------------------------------------------------

# Public site identity
VITE_SITE_URL=https://example.com
VITE_SITE_NAME="Ustadh Academy"
VITE_DEFAULT_LOCALE=en
VITE_DEFAULT_DIRECTION=ltr

# Contact channels
VITE_CONTACT_EMAIL=teacher@example.com
VITE_CONTACT_WHATSAPP=201000000000
VITE_CONTACT_TELEGRAM=your_username

# Booking provider: "calendly" | "preply" | "auto"
# "auto" = use Calendly when VITE_CALENDLY_URL is set, else Preply.
VITE_BOOKING_PROVIDER=auto
VITE_CALENDLY_URL=https://calendly.com/your-name/30min
VITE_PREPLY_URL=https://preply.com/en/teacher/your-name

# Analytics (optional, leave empty to disable)
VITE_ANALYTICS_ID=
